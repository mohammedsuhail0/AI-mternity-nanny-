# AI Maternal-Fetal Monitor
APP_NAME=AI Maternal-Fetal Monitor
DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maternal_monitor
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Audit
AUDIT_LOG_ENABLED=true

# Companion LLM (NVIDIA API)
# Get API key from: https://build.nvidia.com/
# 1. Sign up at https://build.nvidia.com/
# 2. Navigate to "Manage" → "API Keys"
# 3. Create a new API key
# 4. Copy the key and paste below
COMPANION_LLM_API_KEY=your-nvidia-api-key-here
COMPANION_LLM_MODEL=meta/llama-2-70b-chat

# Alternative models:
# - nvidia/nemotron-4-340b-instruct (recommended, most capable)
# - meta/llama-2-70b-chat (good balance of speed and quality)
# - mistralai/mistral-large (fast responses)

# LLM Configuration
COMPANION_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
COMPANION_LLM_TIMEOUT_SECONDS=20.0
